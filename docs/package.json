{
  "name": "gem-dota-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:gen-api": "python ../scripts/generate_vitepress_api_reference.py",
    "docs:gen-proto": "python ../scripts/generate_proto_catalog_docs.py && python ../scripts/generate_proto_field_docs.py",
    "docs:gen": "npm run docs:gen-api",
    "docs:gen-all": "npm run docs:gen-api && npm run docs:gen-proto",
    "docs:dev": "npm run docs:gen && vitepress dev",
    "docs:build": "npm run docs:gen && vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  }
}
