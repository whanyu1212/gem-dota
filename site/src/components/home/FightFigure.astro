---
// Figure 3: the match's biggest fight on the map, with what happened in it.
//
// Rendered here, from home.json: the map with every hero where it was at the
// last death, the death spots, and a narration of the kills and buybacks. That
// is the whole figure without JavaScript.
//
// In the browser, when the figure comes into view, src/lib/fight-player.ts
// loads the fight's playback (src/data/fight.json, written by
// scripts/export_site_home_data.py from gem.build_fight_timeline) and plays the
// fight back: HP and mana, casts and what they hit, damage, disables, buffs and
// gold on the map; each hero's status; and a feed of every cast with the damage
// it did, deaths with their recap, and buybacks.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import fightSource from "../../assets/home-fight.jpg";
import home from "../../data/home.json";
import { clockAt, headAt, tracks } from "../../lib/playback";
import { damageStrip, fightLegend, playbackControls } from "../../lib/fight-markup";

const fight = home.fight!;
const fightImage = await getImage({ src: fightSource, width: 1000, format: "webp", quality: 80 });
const [x, y, size] = fight.box;
// Marks are sized in screen pixels (the map renders about 480 px wide on a desktop),
// whatever the zoom. The playback measures the map it is drawn on.
const px = size / 480;
const heroes = tracks(fight.paths, fight.deaths_at);

// Hero and item icons, copied in by the export script.
const heroIcons = import.meta.glob<ImageMetadata>("../../assets/icons/heroes/*.png", { eager: true, import: "default" });
const itemIcons = import.meta.glob<ImageMetadata>("../../assets/icons/items/*.png", { eager: true, import: "default" });
const iconName = (path: string) => path.split("/").at(-1)!.replace(".png", "");
// Item icons are shown at 22 px wide or less: serve small WebP copies, not the 88 px PNGs.
const items = await Promise.all(
  Object.entries(itemIcons).map(async ([path, image]) => {
    const small = await getImage({ src: image, width: 44, format: "webp", quality: 85 });
    return [iconName(path), small.src] as const;
  }),
);
const icons = {
  heroes: Object.fromEntries(Object.entries(heroIcons).map(([path, image]) => [iconName(path), image.src])),
  items: Object.fromEntries(items),
};
const BADGE = 11 * px; // badge radius
// The final frame, shown until the playback starts: where each hero was at the last death.
const finalAt = heroes.map((hero) => headAt(hero, fight.duration_s));

const gold = (n: number) => n.toLocaleString("en-US");
const winner = fight.winner === "radiant" ? "Radiant" : fight.winner === "dire" ? "Dire" : null;
const { radiant, dire } = fight.totals;
const footer =
  `${winner ? `${winner} had more kills.` : "Kills were even."} In the fight's window the heroes near it earned: ` +
  `Radiant ${gold(radiant.gold)} gold and ${gold(radiant.xp)} XP, Dire ${gold(dire.gold)} gold and ${gold(dire.xp)} XP.`;
const view = { box: fight.box, px, icons };
---

<div class="fight" data-fight>
  <figure class="fig">
    <div class="fight-layers" data-layers hidden></div>
    <svg class="map" viewBox={`${x} ${y} ${size} ${size}`} role="img" aria-labelledby="fight-caption" data-map>
      <defs>
        <clipPath id="hero-badge" clipPathUnits="userSpaceOnUse"><circle r={BADGE}></circle></clipPath>
      </defs>
      <image href={fightImage.src} x={x} y={y} width={size} height={size} preserveAspectRatio="xMidYMid slice"></image>
      <rect class="map-dim map-dim--fight" x={x} y={y} width={size} height={size}></rect>
      <g data-static>
        {fight.deaths_at.map((death) => (
          <g class={`fight-death fight-death--${death.team}`} transform={`translate(${death.at[0]} ${death.at[1]}) scale(${px})`}>
            <path class="halo" d="M-5,-5 L5,5 M5,-5 L-5,5"></path>
            <path d="M-5,-5 L5,5 M5,-5 L-5,5"></path>
          </g>
        ))}
        {heroes.map((hero, i) => (
          <g
            class={`fight-hero fight-hero--${hero.team}`}
            transform={finalAt[i] ? `translate(${finalAt[i]![0]} ${finalAt[i]![1]})` : undefined}
            style={finalAt[i] ? undefined : "display: none"}
          >
            <title>{hero.hero}</title>
            <circle class="hero-ring" r={BADGE + 2 * px} stroke-width={1.2 * px}></circle>
            <image href={icons.heroes[hero.icon]} x={-BADGE} y={-BADGE} width={BADGE * 2} height={BADGE * 2} clip-path="url(#hero-badge)"></image>
          </g>
        ))}
      </g>
    </svg>
    <Fragment set:html={playbackControls(clockAt(fight.start, fight.duration_s))} />
    <Fragment set:html={damageStrip()} />
    <Fragment set:html={fightLegend()} />
    <figcaption id="fight-caption">
      <b>Figure 3.</b> The match's biggest fight, {fight.start}–{fight.end}<span data-caption-static>: each hero,
      ringed in its team's colour, where it was at the last death, and ✕ where each hero died.</span><span
      data-caption-live hidden>, played back at 2×: HP and mana under each hero, casts and the heroes they hit,
      damage lines by type, a draining arc while a hero is disabled, rings for some buffs, and the gold at each
      death. The feed lists every disable, debuff and buff a hero put on another (or on itself).
      A faded hero is hidden from the enemy team (the replay's own visibility), and a grey cloud marks a smoked
      hero; when a smoke led into the fight, the playback starts at it. Click a hero to follow it. Drag across the timeline, or click a death or buyback on it, to list just
      that stretch in the feed and loop it. Positions, HP and mana are read on every replay packet (15 a
      second, the replay's own rate); the rest is the combat log, to the tick.</span>
    </figcaption>
  </figure>
  <aside class="narration" aria-label="What happened in the fight">
    <p class="narration-head">
      <span>{fight.start}–{fight.end}</span>
      <span>{fight.deaths} deaths · Radiant {fight.radiant_kills}, Dire {fight.dire_kills}</span>
    </p>
    <div class="fight-status" data-status hidden></div>
    <div class="feed-filters" data-filters hidden></div>
    <ol data-events>
      {fight.events.map((event) => (
        <li class={`event event--${event.team}`}>
          <time>{event.time}</time>
          <span>{event.text}</span>
        </li>
      ))}
    </ol>
    <ol class="feed" data-feed hidden></ol>
    <p class="narration-foot">{footer}</p>
  </aside>
  <script type="application/json" data-fight-view set:html={JSON.stringify(view)} />
</div>

<script>
  import { mountFightPlayer } from "../../lib/fight-player";

  const root = document.querySelector<HTMLElement>("[data-fight]");
  if (root) mountFightPlayer(root);
</script>
