---
// A bare layout until the Editorial theme lands (HY-113).
import { render } from "astro:content";
import type { DocEntry } from "../lib/docs";

interface Props {
  entry: DocEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const firstHeading = headings.find((h) => h.depth === 1)?.text;
const title = entry.data.title ?? firstHeading ?? "gem";
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${home}/favicon.svg`} />
    <title>{title === "gem" ? "gem" : `${title} | gem`}</title>
  </head>
  <body>
    <header><a href={`${home}/`}>gem</a></header>
    <main>
      <Content />
    </main>
  </body>
</html>
