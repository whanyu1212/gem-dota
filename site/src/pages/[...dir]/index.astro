---
// A folder's index.md, e.g. reference/index.md. The home page is src/pages/index.astro.
import type { GetStaticPaths } from "astro";
import DocLayout from "../../layouts/DocLayout.astro";
import { getDocs, indexFolder, isIndexPage } from "../../lib/docs";

export const getStaticPaths = (async () => {
  const docs = await getDocs();
  return docs
    // A root index.md would clash with the home page, so it is never routed.
    .filter((entry) => isIndexPage(entry) && entry.id !== "index")
    .map((entry) => ({ params: { dir: indexFolder(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<DocLayout entry={entry} />
