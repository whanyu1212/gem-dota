---
// A folder's index.md, e.g. docs/reference/index.md.
import type { GetStaticPaths } from "astro";
import DocLayout from "../../layouts/DocLayout.astro";
import { getDocs, indexFolder, isIndexPage } from "../../lib/docs";

export const getStaticPaths = (async () => {
  const docs = await getDocs();
  return docs
    // docs/index.md is the VitePress home; the Astro home is src/pages/index.astro.
    .filter((entry) => isIndexPage(entry) && entry.id !== "index")
    .map((entry) => ({ params: { dir: indexFolder(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<DocLayout entry={entry} />
