{
  "name": "gem-dota-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run gen && astro dev",
    "build": "npm run gen && astro build --force && pagefind",
    "preview": "astro preview",
    "check-urls": "node scripts/check-urls.mjs",
    "check": "astro check",
    "check-links": "node scripts/check-links.mjs",
    "test": "vitest run",
    "gen": "python ../scripts/generate_api_reference.py",
    "gen-all": "npm run gen && python ../scripts/generate_proto_field_docs.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.3.5",
    "rehype-raw": "^7.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "pagefind": "^1.5.2",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
